# Copia este archivo como .env y llena los valores reales.
# El archivo .env NUNCA se sube a GitHub ni se comparte.

# =========================================================================
#  EL CEREBRO: elija UNO de los dos
# =========================================================================

# --- OPCION A: Gemini (GRATIS, no pide tarjeta) ---
# Llave en https://aistudio.google.com/apikey
# Limite gratuito: 1.500 consultas al dia. De sobra para empezar.
# OJO: en el plan gratuito Google puede usar las conversaciones para entrenar
# sus modelos. Son charlas con sus clientes: tengalo presente.
PROVEEDOR=gemini
GEMINI_API_KEY=
GEMINI_MODELO=gemini-3.6-flash

# --- OPCION B: Claude (de pago, mejor calidad y no entrena con sus datos) ---
# Llave en https://console.anthropic.com -> API Keys
# Minimo de recarga: 5 dolares. Pongale tope de gasto en esa misma consola.
# Para usar esta opcion: cambie PROVEEDOR=claude arriba y llene esta llave.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# =========================================================================
#  DONDE QUEDAN LOS INTERESADOS
# =========================================================================

# Hoja de Google (MUY recomendado, gratis).
# Es lo que salva los datos cuando el hosting es gratuito y borra el disco.
# Como obtener esta direccion: vea el archivo hoja-de-google.gs
HOJA_WEBHOOK=

# Carpeta de archivos. En su computador dejela vacia.
# En Railway con volumen: /app/registros
REGISTROS_DIR=

# Clave para descargar los registros desde el navegador. Invente una larga.
# Luego: https://su-direccion/registros/lista-de-espera?clave=LO-QUE-PUSO-AQUI
CLAVE_ADMIN=

# Cuantas veces reintenta si el modelo contesta "saturado" (error 503).
# Por defecto 3. Es lo que evita que una saturacion pasajera de Google le
# aparezca al visitante como un error del chat.
REINTENTOS_MODELO=3

# Modelo de respaldo, opcional. Si el de arriba sigue saturado despues de los
# reintentos, prueba con este. Dejelo vacio si no sabe cual poner.
GEMINI_MODELO_RESPALDO=

# =========================================================================
#  CATALOGO AUTOMATICO
# =========================================================================

# El bot mantiene el catalogo al dia de dos maneras. La buena es que el plugin
# de WordPress se lo MANDE (ver CLAVE_CATALOGO abajo). La otra es que el bot
# vaya a LEER la tienda, que no sirve si el hosting lo bloquea con un captcha.
# Las dos ultimas variables son solo para ese modo de lectura: dejelas vacias salvo
# que la tienda cambie de direccion.

# Clave del buzon del catalogo. El plugin de WordPress le manda la lista de
# productos al bot usando esta clave, y asi el chat queda al dia al instante.
# Ponga aqui la MISMA que escriba en Ajustes -> Chat AZZAO -> Clave del catalogo.
# Sin esta variable el buzon queda cerrado.
CLAVE_CATALOGO=

# Direccion de la tienda. Por defecto: https://azzao.com
TIENDA_URL=

# Cada cuantos minutos vuelve a mirar la tienda. Por defecto: 15
CATALOGO_MINUTOS=

# =========================================================================
#  SEGURIDAD Y SERVIDOR
# =========================================================================

# Dominios autorizados a usar el chat, separados por coma, sin barra final.
# Sin esto, cualquier pagina de internet podria gastarle la cuota.
DOMINIOS_PERMITIDOS=https://azzao.com,https://www.azzao.com

# Maximo de mensajes por hora desde una misma conexion.
LIMITE_MENSAJES_HORA=40

# Puerto. En Railway o Render no lo toque: el servicio lo asigna solo.
PORT=3000

# =========================================================================
#  WHATSAPP (opcional, para mas adelante)
# =========================================================================
# Mientras esten vacios, el bot funciona solo como chat web.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=azzao-verifica-2026
WHATSAPP_APP_SECRET=
NUMERO_ASESOR=
